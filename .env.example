# Binance Pay merchant API (server-only; never prefix these with REACT_APP_)
BINANCE_PAY_ENABLED=false
BINANCE_PAY_CERT_SN=
BINANCE_PAY_SECRET_KEY=
BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com
BINANCE_PAY_CURRENCIES=BNB,USDT,USDC
AI_USAGE_SALT=replace-with-a-long-random-private-value
REACT_APP_ENABLE_UPI=false

# Required for durable order reconciliation and authenticated admin access
DATABASE_URL=
CLERK_SECRET_KEY=
EDG_ADMIN_EMAILS=admin@engineeringdrawing.io

# Public canonical URLs used for redirect and webhook construction
SITE_URL=https://www.engineeringdrawing.io
PUBLIC_API_URL=https://www.engineeringdrawing.io
